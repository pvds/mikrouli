{
	"name": "mikrouli",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"bun": "^1.4"
	},
	"devEngines": {
		"runtime": {
			"name": "bun",
			"onFail": "error",
			"version": "1.4"
		},
		"packageManager": {
			"name": "bun",
			"onFail": "error",
			"version": "1.4"
		}
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/pvds/mikrouli"
	},
	"scripts": {
		"outdated": "bun outdated",
		"setup": "bun run scripts/workspace/setup.js",
		"clean": "bun run scripts/workspace/clean.js",
		"prepare": "bun run sync && lefthook install",
		"sync": "svelte-kit sync",
		"start": "vite dev --host",
		"start:prod": "bun run build:prod && bun run preview:prod --open",
		"build": "vite build",
		"build:prod": "DEPLOY_TARGET=production vite build --mode production",
		"preview": "vite preview",
		"preview:prod": "DEPLOY_TARGET=production vite preview --mode production",
		"test:html": "html-validate --config .htmlvalidate.json \"build/production/**/*.html\"",
		"test:lighthouse": "bun run scripts/test/lighthouse.js",
		"test:axe": "bun run scripts/test/axe.js",
		"watch": "bun run check:lint --watch",
		"check": "bun run check:format & bun run check:lint",
		"check:ci": "biome ci --skip-parse-errors && bun run check:lint",
		"check:all": "bun run check & bun run build -l warn",
		"check:format": "biome check --skip-parse-errors .",
		"check:lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"write": "biome check --write --skip-parse-errors .",
		"content": "bun run content:fetch --force && bun run assets",
		"content:fetch": "bun run scripts/content/fetch.js",
		"assets": "bun run assets:fetch --cms && bun run assets:process --local --cms",
		"assets:fetch": "bun run scripts/assets/fetch.js",
		"assets:process": "bun run scripts/assets/process.js",
		"assets:favicons": "bunx realfavicon generate images/icon.svg favicons.json .favicons.json static/pwa",
		"skills": "bunx skills update -y"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@biomejs/biome": "^2.5.10",
		"@evilmartians/lefthook": "^2.1.10",
		"@oddbird/popover-polyfill": "^0.7.2",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"contentful": "^11.12.9",
		"html-validate": "^11.8.0",
		"marked": "^18.0.10",
		"marked-gfm-heading-id": "^4.1.4",
		"playwright": "^1.62.1",
		"playwright-lighthouse": "^4.0.0",
		"schema-dts": "^2.0.0",
		"sharp": "^0.35.3",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sitemap": "^4.0.4",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.1",
		"vite-plugin-browser-sync": "^7.0.0"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"@evilmartians/lefthook",
		"@tailwindcss/oxide",
		"esbuild"
	],
	"browserslist": [
		"baseline widely available with downstream"
	],
	"overrides": {
		"playwright-core": "$playwright"
	}
}
